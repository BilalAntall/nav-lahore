rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if owns(userId);
      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly(['profile', 'updatedAt']);
      allow update: if owns(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile', 'updatedAt']);

      match /savedRoutes/{routeId} {
        allow read, create, update, delete: if owns(userId);
      }
    }

    match /communityAlerts/{alertId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /raahiUsage/{userId} {
      allow read: if owns(userId);
      allow write: if false;
    }
  }
}
